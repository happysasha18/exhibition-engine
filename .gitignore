.venv/
__pycache__/
*.pyc
.publish-pass-checkpoint.md
.adopt-checkpoint.md
.live-spec/checkpoints/*
!.live-spec/checkpoints/.gitkeep
# A suite's kept captures (§9 row 16). They stay on disk after a run, where the row that counts them
# reads them; each run writes them afresh, and eleven megabytes of that belongs outside the history.
tests/captures/
# Every full run rewrites this file (S-61); a clean tree can't hold it under version control.
tests/suite_timings.json

# Written by every suite run, like tests/suite_timings.json above it: machine output, never source.
tests/route_wire_fence.txt
